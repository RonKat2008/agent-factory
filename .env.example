# Neon Postgres connection string (from the Vercel Neon integration via `vercel env pull`)
DATABASE_URL=
# AI Gateway key; optional locally because VERCEL_OIDC_TOKEN from `vercel env pull` works
AI_GATEWAY_API_KEY=
# Gateway model id for quality-sensitive calls (default anthropic/claude-sonnet-5.5)
MODEL_SMART=anthropic/claude-sonnet-5.5
# Gateway model id for cheap/fast calls (default anthropic/claude-haiku-5.5)
MODEL_FAST=anthropic/claude-haiku-5.5
# Bearer secret Vercel Cron sends to /api/cron/tick
CRON_SECRET=
# Admin key guarding admin/demo endpoints
ADMIN_KEY=
# Slack incoming webhook URL used by agent outputs
SLACK_WEBHOOK_URL=
# GitHub token used by agent outputs
GITHUB_TOKEN=
# Public base URL of the app (http://localhost:3000 locally)
APP_URL=http://localhost:3000
# "true" serves seeded data and canned AI replies (src/lib/demo.ts)
DEMO_MODE=false
