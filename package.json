    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.140",
    "botid": "^1.5.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "cron-parser": "^5.10.2",
    "cronstrue": "^3.32.0",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "workflow": "^5.2.2",
    "zod": "^4.6.7"
